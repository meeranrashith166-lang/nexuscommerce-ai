# PayPal Sandbox Credentials (Obtain from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# Optional: AI Provider (defaults to intelligent local mock engine if empty for zero-setup demo)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Port
PORT=8000

